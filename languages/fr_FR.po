#: inc/customizer.php:124
msgid "Header layout"
msgstr "Disposition du header"

#: inc/customizer.php:128
msgid "Classic: logo left, menu right"
msgstr "Classique : logo à gauche, menu à droite"

#: inc/customizer.php:129
msgid "Centered: logo above, menu below"
msgstr "Centrée : logo au-dessus, menu en dessous"

#: inc/customizer.php:138
msgid "Sticky header"
msgstr "Header fixe au défilement"

#: inc/customizer.php:148
msgid "Transparent header when applicable"
msgstr "Header transparent quand c'est possible"

#: inc/customizer.php:149
msgid "The header is transparent over the page until the user scrolls, on pages that start with a hero section (a section whose name contains \"hero\")."
msgstr "Le header est transparent par-dessus la page jusqu'au défilement, sur les pages qui commencent par une section hero (une section dont le nom contient « hero »)."


msgstr "Recherche"

#: inc/customizer.php:160
msgid "Search icon in the header, opening the search form."
msgstr "Icône de recherche dans le header, qui ouvre le formulaire de recherche."

#: inc/customizer.php:170
msgid "Account link"
msgstr "Lien vers le compte"

#: inc/customizer.php:171
msgid "Icon linking to the WooCommerce \"My account\" page, next to the cart. Requires WooCommerce."
msgstr "Icône vers la page « Mon compte » de WooCommerce, à côté du panier. Nécessite WooCommerce."

#: inc/customizer.php:181
msgid "Mobile header"
msgstr "Header mobile"

#: inc/customizer.php:190
msgid "Sticky header on mobile"
msgstr "Header fixe sur mobile"

#: inc/customizer.php:200
msgid "Mobile breakpoint (px)"
msgstr "Point de rupture mobile (px)"

#: inc/customizer.php:201
msgid "Below this width, the menu collapses into the mobile menu. Raise it when the menu has many items."
msgstr "Sous cette largeur, le menu passe en menu mobile. À augmenter quand le menu a beaucoup d'entrées."

#: inc/customizer.php:216
msgid "Page transitions"
msgstr "Transitions de page"

#: inc/customizer.php:218
msgid "Uses the browser View Transitions API: no JavaScript. Browsers without support simply load the page normally."
msgstr "Utilise la View Transitions API du navigateur, sans JavaScript. Les navigateurs qui ne la gèrent pas chargent simplement la page."

#: inc/customizer.php:226
msgid "Animated page transitions"
msgstr "Transitions animées entre les pages"


                    "sub_fields": [
                        {
                            "name": "icon",
                            "key": "field_mrz_footer_social_icon",
                            "type": "image",
                            "label": "Icon",
                            "return_format": "id"
                        },
                        {
                            "name": "url",
                            "key": "field_mrz_footer_social_url",
                            "type": "url",
                            "label": "Link"
                        },
                        {
                            "name": "name",
                            "key": "field_mrz_footer_social_name",
                            "type": "text",
                            "label": "Name"
                        }
                    ]
                },
                {
                    "name": "free_title",
                    "key": "field_mrz_footer_free_title",

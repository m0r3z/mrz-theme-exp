                    "type": "repeater",
                    "label": "Link columns",
                    "sub_fields": [
                        {
                            "name": "title",
                            "key": "field_mrz_footer_column_title",
                            "type": "text",
                            "label": "Title"
                        },
                        {
                            "name": "links",
                            "key": "field_mrz_footer_column_links",
                            "type": "wysiwyg",
